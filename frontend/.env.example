# AI Hiring Frontend Environment Variables
# Copy this file to .env.local and update the values

# OpenRouter API Configuration
REACT_APP_OPENROUTER_API_KEY=your-openrouter-api-key-here

# Backend API URL (if different from proxy)
REACT_APP_API_URL=http://localhost:5000

# Note: In production, REACT_APP_API_URL should point to your production backend
# Example: REACT_APP_API_URL=https://api.yourdomain.com
