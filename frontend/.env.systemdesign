# System Design Standalone App Configuration
# This file contains the URL where the System Design app is hosted

# Development - Run the System Design app separately on port 5174
# cd frontend/src/components/System-design && npm run dev
REACT_APP_SYSTEM_DESIGN_URL=http://localhost:5174

# Production - Deploy System Design app separately and update this URL
# REACT_APP_SYSTEM_DESIGN_URL=https://systemdesign.eval8.xyz
