# Production Environment Variables for AI Hiring Platform
# Copy this file to .env.production and update with your actual values

# Backend API URL - REQUIRED
REACT_APP_API_URL=https://aihiring.eval8.ai

# Node Environment
NODE_ENV=production

# OpenRouter API Configuration (Optional - for AI features)
REACT_APP_OPENROUTER_API_KEY=your-openrouter-api-key-here

# System Design App URL (Optional - if using separate deployment)
REACT_APP_SYSTEM_DESIGN_URL=https://systemdesign.eval8.ai

# PCB Design App URL (Optional - if using separate deployment)
REACT_APP_PCB_DESIGN_URL=https://pcb1.eval8.ai

# Note: Make sure all URLs use HTTPS in production
# Note: Do not commit .env.production to version control
